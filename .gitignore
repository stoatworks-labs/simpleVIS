# Never commit fixture files from vendor libraries — they are the vendors'
# content. Tests locate MA's Demostage_MVR.mvr in an installed grandMA3 and
# skip when it is absent. See packages/core/test/fixtures.ts.
*.mvr
*.gdtf
# Vendor fixture files must never reach a build: anything under an app's
# public/ directory is copied verbatim into dist/ and would be published.
# scripts/verify-render.mjs reads the MVR straight off disk over CDP instead.
packages/app/public/dev/
